[Unit]
Description=Karaoke tidy: file phone-added songs into genre folders (n8n + two-model agreement)
Documentation=file:///usr/local/bin/karaoke-tidy.py
After=network-online.target pikaraoke.service
Wants=network-online.target
RequiresMountsFor=__LIBRARY_PATH__

[Service]
Type=oneshot
# root: moves files on the network mount and restarts pikaraoke when something moved.
# Run the script by hand WITHOUT --execute first and read its plan.
Environment=KARAOKE_TIDY_WEBHOOK=__N8N_WEBHOOK_URL__
Environment=KARAOKE_LIBRARY=__LIBRARY_PATH__
Environment=PIKARAOKE_URL=__PIKARAOKE_URL__
Environment=LANG=C.UTF-8 LC_ALL=C.UTF-8
ExecStart=/usr/bin/python3 /usr/local/bin/karaoke-tidy.py --execute
TimeoutStartSec=1800
